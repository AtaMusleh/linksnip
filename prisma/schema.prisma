generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Link {
  id        String    @id @default(cuid())
  slug      String    @unique
  url       String
  ownerKey  String
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  clicks    Click[]

  @@index([ownerKey])
}

model Click {
  id        String   @id @default(cuid())
  linkId    String
  link      Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  clickedAt DateTime @default(now())
  referrer  String?
  country   String?

  @@index([linkId, clickedAt])
}
